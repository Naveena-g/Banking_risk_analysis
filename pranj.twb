            <groupfilter function='level-members' level='[tmn:LASTPAYMENTDATE (DUMMYLOAN):ok]' user:ui-action-filter='[Action2_AEC72D5ACB674A2A97BE29ED9F39779D]' user:ui-enumeration='all' user:ui-marker='enumerate' />
