      </column>
      <column caption='DPD First' datatype='integer' name='[Calculation_315533453754699788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [LOANID (DUMMYCOLLECTIONEVENTS)], [Calculation_1324902720438091776] :&#13;&#10;    MIN( IIF([EVENTDATE] = { FIXED [LOANID (DUMMYCOLLECTIONEVENTS)], [Calculation_1324902720438091776] : MIN([EVENTDATE]) }, [DPD], NULL) )&#13;&#10;}' />
      </column>
      <column caption='DPD Last' datatype='integer' name='[Calculation_315533453754806285]' role='measure' type='quantitative'>
