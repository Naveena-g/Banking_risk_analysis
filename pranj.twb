    <worksheet name='Geo Filter Controller'>
      <table>
        <view>
          <datasources>
            <datasource caption='LOAN_DATA (MY_DATABASE.LOAN_DATA)+ (MY_SCHEMA)' name='federated.1y8gen81wh4ali1gr5owa0s5yf00' />
          </datasources>
          <datasource-dependencies datasource='federated.1y8gen81wh4ali1gr5owa0s5yf00'>
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Currentbalance (Dummyloan)' datatype='real' name='[CURRENTBALANCE (DUMMYLOAN)]' role='measure' type='quantitative' />
            <column caption='NPL%' datatype='real' name='[Calculation_1600466722628743172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [STATUS (DUMMYLOAN)] = &apos;Delinquent&apos; OR&#13;&#10;[DPD] &gt;= 90 THEN [CURRENTBALANCE (DUMMYLOAN)]ELSE 0&#13;&#10;END)/ SUM([CURRENTBALANCE (DUMMYLOAN)])*100' />
            </column>
