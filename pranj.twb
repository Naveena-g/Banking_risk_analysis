      <aliases enabled='yes' />
      <column caption='Actiontype' datatype='string' name='[ACTIONTYPE]' role='dimension' type='nominal' />
      <column caption='Agentid' datatype='string' datatype-customized='true' name='[AGENTID]' role='dimension' type='nominal' />
      <column caption='Annualincome' datatype='integer' name='[ANNUALINCOME]' role='measure' type='quantitative' />
      <column caption='Apr (Dummyloan)' datatype='real' name='[APR (DUMMYLOAN)]' role='measure' type='quantitative' />
      <column caption='Branch' datatype='string' name='[BRANCH]' role='dimension' type='nominal' />
      <column caption='Bureauid' datatype='integer' name='[BUREAUID]' role='measure' type='quantitative' />
      <column caption='Channel (Dummyloan)' datatype='string' name='[CHANNEL (DUMMYLOAN)]' role='dimension' type='nominal' />
      <column caption='Closeddate (Dummyloan)' datatype='date' name='[CLOSEDDATE (DUMMYLOAN)]' role='dimension' type='ordinal' />
      <column caption='Collateralid' datatype='integer' name='[COLLATERALID]' role='measure' type='quantitative' />
      <column caption='Collateralizedflag (Dummyloan)' datatype='integer' name='[COLLATERALIZEDFLAG (DUMMYLOAN)]' role='measure' type='quantitative' />
      <column caption='Collateraltype' datatype='string' name='[COLLATERALTYPE]' role='dimension' type='nominal' />
      <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Currency (Dummyloan)' datatype='string' name='[CURRENCY (DUMMYLOAN)]' role='dimension' type='nominal' />
      <column caption='Currentbalance (Dummyloan)' datatype='real' name='[CURRENTBALANCE (DUMMYLOAN)]' role='measure' type='quantitative' />
      <column caption='Customerid (Bureau Scores)' datatype='integer' name='[CUSTOMERID (BUREAU_SCORES)]' role='measure' type='quantitative' />
      <column caption='Customerid (Customer Master)' datatype='integer' name='[CUSTOMERID (CUSTOMER_MASTER)]' role='measure' type='quantitative' />
      <column caption='Customerid (Dummyloan)' datatype='integer' name='[CUSTOMERID (DUMMYLOAN)]' role='measure' type='quantitative' />
      <column caption='Customername' datatype='string' name='[CUSTOMERNAME]' role='dimension' type='nominal' />
      <column caption='DPD Bucket' datatype='string' name='[Calculation_1600466722627321856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [DPD] = 0 THEN &quot;Current&quot;&#13;&#10;ELSEIF [DPD] &gt; 0 AND [DPD] &lt;= 30 THEN &quot;1–30 DPD&quot;&#13;&#10;ELSEIF [DPD] &gt; 30 AND [DPD] &lt;= 60 THEN &quot;31–60 DPD&quot;&#13;&#10;ELSEIF [DPD] &gt; 60 AND [DPD] &lt;= 90 THEN &quot;61–90 DPD&quot;&#13;&#10;ELSE &quot;90+ DPD&quot;&#13;&#10;END' />
      </column>
      <column caption='Cure Flag' datatype='integer' name='[Calculation_1600466722627448833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [DPD] &lt; 30 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Cure%' datatype='real' name='[Calculation_1600466722628386818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [DPD] &lt; 30 THEN 1 ELSE 0 END) / &#13;&#10;COUNT([LOANID (DUMMYLOAN)])' />
      </column>
      <column caption='Loss Ratio' datatype='real' name='[Calculation_1600466722628575235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [STATUS (DUMMYLOAN)] = &apos;WrittenOff&apos; THEN [CURRENTBALANCE (DUMMYLOAN)]&#13;&#10;    ELSE 0 END&#13;&#10;) / SUM([ORIGINATIONAMOUNT (DUMMYLOAN)])' />
      </column>
      <column caption='NPL%' datatype='real' name='[Calculation_1600466722628743172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [STATUS (DUMMYLOAN)] = &apos;Delinquent&apos; OR&#13;&#10;[DPD] &gt;= 90 THEN [CURRENTBALANCE (DUMMYLOAN)]ELSE 0&#13;&#10;END)/ SUM([CURRENTBALANCE (DUMMYLOAN)])*100' />
      </column>
      <column caption='Write-Off%' datatype='real' name='[Calculation_1600466722628919301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [STATUS (DUMMYLOAN)] = &apos;WrittenOff&apos; THEN &#13;&#10;[CURRENTBALANCE (DUMMYLOAN)]ELSE 0 END&#13;&#10;) / SUM([ORIGINATIONAMOUNT (DUMMYLOAN)])*100' />
      </column>
      <column caption='Recovery%' datatype='real' name='[Calculation_1600466722629070854]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ORIGINATIONAMOUNT (DUMMYLOAN)]-[CURRENTBALANCE (DUMMYLOAN)]) /&#13;&#10; SUM([ORIGINATIONAMOUNT (DUMMYLOAN)])&#13;&#10;*100' />
      </column>
      <column caption='PAR%' datatype='real' name='[Calculation_1600466722629287943]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [DPD] &gt;= 30 THEN [CURRENTBALANCE (DUMMYLOAN)]&#13;&#10;    ELSE 0 END&#13;&#10;) / SUM([CURRENTBALANCE (DUMMYLOAN)])*100' />
      </column>
      <column caption='Net Loss Ratio' datatype='real' name='[Calculation_1600466722629443592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1600466722628919301] - [Calculation_1600466722629070854])' />
      </column>
      <column caption='Regional Risk' datatype='string' name='[Calculation_1600466722672107530]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1600466722629287943] &gt;91 AND [Calculation_1600466722628743172] &gt;32 THEN &quot;High Risk&quot;&#13;&#10;ELSEIF [Calculation_1600466722629287943] &gt; 66 AND [Calculation_1600466722628743172] &gt;25 THEN &quot;Medium Risk&quot;&#13;&#10;ELSE &quot;Low Risk&quot;&#13;&#10;END' />
      </column>
      <column caption='PTP%' datatype='real' name='[Calculation_1600466722696568843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [PTP_FLAG] = 1 THEN 1 ELSE 0 END) / COUNT([EVENTID])' />
      </column>
      <column caption='Agent Rank ' datatype='integer' name='[Calculation_1600466722701471757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE([Calculation_1600466722696568843], &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='cured loan' datatype='integer' name='[Calculation_1600466722711744527]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [DPD] &lt; 30 THEN 1 ELSE 0 END' />
      </column>
      <column caption='TOTAL CALL' datatype='integer' name='[Calculation_1600466722733592594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([EVENTID])' />
      </column>
      <column caption='PTP Call Count' datatype='integer' name='[Calculation_1600466722734444563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [PTP_FLAG] = 1 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_1600466722749562901]' role='measure' type='quantitative'>
