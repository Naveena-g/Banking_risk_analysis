    <worksheet name='cal'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Net Loss Tracking</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MY_SCHEMA' name='federated.1jaj6y417jjbjm1d2k5wt0fgwtdq' />
          </datasources>
          <datasource-dependencies datasource='federated.1jaj6y417jjbjm1d2k5wt0fgwtdq'>
            <column caption='Currentbalance' datatype='real' name='[CURRENTBALANCE]' role='measure' type='quantitative' />
            <column caption='Origination Amount' datatype='real' name='[Calculation_1324902720488214537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ORIGINATIONAMOUNT] )' />
            </column>
            <column caption='Recovery Amount' datatype='real' name='[Calculation_1324902720490557451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PAYMENTAMOUNT])' />
            </column>
            <column caption='Net Loss' datatype='real' name='[Calculation_1324902720490688524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ORIGINATIONAMOUNT])&#13;&#10;- SUM([PAYMENTAMOUNT])&#13;&#10;- SUM( IIF([WRITEOFFFLAG] = 0, [CURRENTBALANCE], 0) )' />
            </column>
            <column caption='Origination Year' datatype='date' datatype-customized='true' name='[Calculation_1324902720520458261]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;yyyy&quot;, STR(YEAR([ORIGINATIONDATE])) )) ' />
            </column>
            <column caption='Originationamount' datatype='real' name='[ORIGINATIONAMOUNT]' role='measure' type='quantitative' />
            <column caption='Originationdate' datatype='date' name='[ORIGINATIONDATE]' role='dimension' type='ordinal' />
            <column caption='Paymentamount' datatype='real' name='[PAYMENTAMOUNT]' role='measure' type='quantitative' />
            <column datatype='string' name='[REGION]' role='dimension' type='nominal' />
            <column caption='Writeoffflag' datatype='integer' name='[WRITEOFFFLAG]' role='measure' type='quantitative' />
            <column-instance column='[REGION]' derivation='None' name='[none:REGION:nk]' pivot='key' type='nominal' />
