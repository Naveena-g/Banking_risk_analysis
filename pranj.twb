    <worksheet name='cure'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Benton Sans Book'>Cure Percentage</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='LOAN_DATA (MY_DATABASE.LOAN_DATA)+ (MY_SCHEMA)' name='federated.1y8gen81wh4ali1gr5owa0s5yf00' />
          </datasources>
          <datasource-dependencies datasource='federated.1y8gen81wh4ali1gr5owa0s5yf00'>
            <column caption='Cure%' datatype='real' name='[Calculation_1600466722628386818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [DPD] &lt; 30 THEN 1 ELSE 0 END) / &#13;&#10;COUNT([LOANID (DUMMYLOAN)])' />
            </column>
            <column caption='PTP%' datatype='real' name='[Calculation_1600466722696568843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [PTP_FLAG] = 1 THEN 1 ELSE 0 END) / COUNT([EVENTID])' />
            </column>
            <column datatype='integer' name='[DPD]' role='measure' type='quantitative' />
            <column caption='Eventid' datatype='integer' name='[EVENTID]' role='measure' type='quantitative' />
            <column caption='Loanid (Dummyloan)' datatype='integer' name='[LOANID (DUMMYLOAN)]' role='measure' type='quantitative' />
