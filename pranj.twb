    <worksheet name='Sheet 14 (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Benton Sans Book'>Active, Closed and Delinquent</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MY_SCHEMA' name='federated.1jaj6y417jjbjm1d2k5wt0fgwtdq' />
          </datasources>
          <datasource-dependencies datasource='federated.1jaj6y417jjbjm1d2k5wt0fgwtdq'>
            <column caption='Currentbalance' datatype='real' name='[CURRENTBALANCE]' role='measure' type='quantitative' />
            <column caption='Origination Year' datatype='date' datatype-customized='true' name='[Calculation_1324902720520458261]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;yyyy&quot;, STR(YEAR([ORIGINATIONDATE])) )) ' />
            </column>
            <column caption='Total Amount' datatype='real' name='[Calculation_1324902720790892582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE LOWER([STATUS])&#13;&#10;    WHEN &quot;active&quot; THEN [CURRENTBALANCE]&#13;&#10;    WHEN &quot;delinquent&quot; THEN -[CURRENTBALANCE]&#13;&#10;    WHEN &quot;write-off&quot; THEN -[CURRENTBALANCE]&#13;&#10;    WHEN &quot;closed&quot; THEN [CURRENTBALANCE]&#13;&#10;END' />
            </column>
            <column caption='change status' datatype='string' name='[Calculation_1324902720791023655]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1324902720790892582] &gt; 0 THEN &quot;Increase&quot;&#13;&#10;ELSE &quot;Decrease&quot;&#13;&#10;END' />
            </column>
            <column caption='Originationdate' datatype='date' name='[ORIGINATIONDATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[REGION]' role='dimension' type='nominal' />
            <column caption='Status' datatype='string' name='[STATUS]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1324902720791023655]' derivation='None' name='[none:Calculation_1324902720791023655:nk]' pivot='key' type='nominal' />
            <column-instance column='[REGION]' derivation='None' name='[none:REGION:nk]' pivot='key' type='nominal' />
            <column-instance column='[STATUS]' derivation='None' name='[none:STATUS:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1324902720790892582]' derivation='Sum' name='[sum:Calculation_1324902720790892582:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1324902720520458261]' derivation='Year' name='[yr:Calculation_1324902720520458261:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1jaj6y417jjbjm1d2k5wt0fgwtdq].[none:REGION:nk]' filter-group='4'>
            <groupfilter function='level-members' level='[none:REGION:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1jaj6y417jjbjm1d2k5wt0fgwtdq].[none:STATUS:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:STATUS:nk]' />
