    <worksheet name='Trend of NPL% over time'>
      <table>
        <view>
          <datasources>
            <datasource caption='LOAN_DATA (MY_DATABASE.LOAN_DATA)+ (MY_SCHEMA)' name='federated.1y8gen81wh4ali1gr5owa0s5yf00' />
          </datasources>
          <datasource-dependencies datasource='federated.1y8gen81wh4ali1gr5owa0s5yf00'>
            <column caption='Currentbalance (Dummyloan)' datatype='real' name='[CURRENTBALANCE (DUMMYLOAN)]' role='measure' type='quantitative' />
            <column caption='NPL%' datatype='real' name='[Calculation_1600466722628743172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [STATUS (DUMMYLOAN)] = &apos;Delinquent&apos; OR&#13;&#10;[DPD] &gt;= 90 THEN [CURRENTBALANCE (DUMMYLOAN)]ELSE 0&#13;&#10;END)/ SUM([CURRENTBALANCE (DUMMYLOAN)])*100' />
            </column>
            <column datatype='integer' name='[DPD]' role='measure' type='quantitative' />
            <column caption='Lastpaymentdate (Dummyloan)' datatype='date' name='[LASTPAYMENTDATE (DUMMYLOAN)]' role='dimension' type='ordinal' />
            <column caption='Originationdate (Dummyloan)' datatype='date' name='[ORIGINATIONDATE (DUMMYLOAN)]' role='dimension' type='ordinal' />
            <column caption='Riskband (Dummyloan)' datatype='string' name='[RISKBAND (DUMMYLOAN)]' role='dimension' type='nominal' />
            <column caption='Status (Dummyloan)' datatype='string' name='[STATUS (DUMMYLOAN)]' role='dimension' type='nominal' />
            <column-instance column='[RISKBAND (DUMMYLOAN)]' derivation='None' name='[none:RISKBAND (DUMMYLOAN):nk]' pivot='key' type='nominal' />
            <column-instance column='[LASTPAYMENTDATE (DUMMYLOAN)]' derivation='Month-Trunc' name='[tmn:LASTPAYMENTDATE (DUMMYLOAN):ok]' pivot='key' type='ordinal' />
            <column-instance column='[ORIGINATIONDATE (DUMMYLOAN)]' derivation='Month-Trunc' name='[tmn:ORIGINATIONDATE (DUMMYLOAN):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1600466722628743172]' derivation='User' name='[usr:Calculation_1600466722628743172:qk]' pivot='key' type='quantitative' />
