      <column caption='Customerid (Dimcustomer Backup)' datatype='integer' name='[CUSTOMERID (DIMCUSTOMER_BACKUP)]' role='measure' type='quantitative' />
      <column caption='Customerid (Dummycustomermaster)' datatype='integer' name='[CUSTOMERID (DUMMYCUSTOMERMASTER)]' role='measure' type='quantitative' />
