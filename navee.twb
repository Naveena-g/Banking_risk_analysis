      <aliases enabled='yes' />
      <column caption='Actiontype' datatype='string' name='[ACTIONTYPE]' role='dimension' type='nominal' />
      <column caption='Agentid' datatype='integer' name='[AGENTID]' role='measure' type='quantitative' />
      <column caption='Apr (Dummyloan)' datatype='real' name='[APR (DUMMYLOAN)]' role='measure' type='quantitative' />
      <column caption='Branch' datatype='string' name='[BRANCH]' role='dimension' type='nominal' />
      <column caption='Channel' datatype='string' name='[CHANNEL]' role='dimension' type='nominal' />
      <column caption='Closeddate' datatype='date' name='[CLOSEDDATE]' role='dimension' type='ordinal' />
      <column caption='Collateralizedflag' datatype='integer' name='[COLLATERALIZEDFLAG]' role='measure' type='quantitative' />
      <column caption='Collateralkey' datatype='integer' name='[COLLATERALKEY]' role='measure' type='quantitative' />
      <column caption='Contactresult' datatype='string' name='[CONTACTRESULT]' role='dimension' type='nominal' />
      <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Curepercent' datatype='real' name='[CUREPERCENT]' role='measure' type='quantitative' />
      <column caption='Currency' datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
      <column caption='Currentbalance (Dummyloan)' datatype='real' name='[CURRENTBALANCE (DUMMYLOAN)]' role='measure' type='quantitative' />
      <column caption='Currentbalance' datatype='real' name='[CURRENTBALANCE]' role='measure' type='quantitative' />
      <column caption='Customerid (Dummyloan)' datatype='integer' name='[CUSTOMERID (DUMMYLOAN)]' role='measure' type='quantitative' />
      <column caption='Customerid' datatype='integer' name='[CUSTOMERID]' role='measure' type='quantitative' />
      <column caption='Customerkey' datatype='integer' name='[CUSTOMERKEY]' role='measure' type='quantitative' />
      <column caption='Customername' datatype='string' name='[CUSTOMERNAME]' role='dimension' type='nominal' />
      <column caption='Customersk (Dimcustomer Backup)' datatype='integer' name='[CUSTOMERSK (DIMCUSTOMER_BACKUP)]' role='measure' type='quantitative' />
      <column caption='Customersk' datatype='integer' name='[CUSTOMERSK]' role='measure' type='quantitative' />
      <column caption='Origination Month' datatype='datetime' name='[Calculation_230809485683544065]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [ORIGINATIONDATE])' />
      </column>
      <column caption='Loan Age (Months)' datatype='datetime' name='[Calculation_230809485685149699]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [ORIGINATIONDATE])' />
      </column>
      <column caption='Is Loss Event' datatype='integer' name='[Calculation_230809485685596164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [DPD] &gt;= 90 OR [WRITEOFFFLAG] = 1 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Loss Amount ' datatype='real' name='[Calculation_230809485686423557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [DPD] &gt;= 90 OR [WRITEOFFFLAG] = 1 THEN &#13;&#10;    [CURRENTBALANCE]&#13;&#10;ELSE &#13;&#10;    0 &#13;&#10;END' />
      </column>
      <column caption='loss%' datatype='real' name='[Calculation_230809485687324678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_230809485686423557]) / SUM([ORIGINATIONAMOUNT])' />
      </column>
      <column caption='writeeoff_amount' datatype='real' name='[Calculation_230809485771898888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [WRITEOFFFLAG] = 1 THEN [CURRENTBALANCE] ELSE 0 END' />
      </column>
      <column caption='total_writeoff_amount' datatype='real' name='[Calculation_230809485772259337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_230809485771898888])' />
      </column>
      <column caption='Loan_age(months)' datatype='integer' name='[Calculation_230809485775208458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [ORIGINATIONDATE], [EVENTDATE])' />
      </column>
      <column caption='Origination_ Month' datatype='datetime' name='[Calculation_230809485775683595]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Calculation_230809485683544065])' />
      </column>
      <column caption='loss_percentage' datatype='real' name='[Calculation_230809485782872077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_230809485686423557]) / SUM([ORIGINATIONAMOUNT]))*100' />
      </column>
      <column caption='Vintage Total Origination (LOD)' datatype='real' name='[Calculation_230809485785120782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_230809485775683595] : SUM([ORIGINATIONAMOUNT]) }' />
      </column>
      <column caption='Cumulative Loss %' datatype='real' name='[Calculation_230809485785862159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_230809485686423557])) / { FIXED [Calculation_230809485775683595] : SUM([ORIGINATIONAMOUNT (DUMMYLOAN)]) }' />
      </column>
      <column caption='loan_count' datatype='integer' name='[Calculation_230809485999267856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([LOANID])' />
      </column>
      <column caption='month_since_origination' datatype='integer' name='[Calculation_230809486001831953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [ORIGINATIONDATE], TODAY())' />
      </column>
      <column caption='Dpd (Dummycollectionevents)' datatype='integer' name='[DPD (DUMMYCOLLECTIONEVENTS)]' role='measure' type='quantitative' />
      <column caption='Email' datatype='string' name='[EMAIL]' role='dimension' type='nominal' />
      <column caption='Eventdate' datatype='date' name='[EVENTDATE]' role='dimension' type='ordinal' />
      <column caption='Eventid (Dummycollectionevents)' datatype='integer' name='[EVENTID (DUMMYCOLLECTIONEVENTS)]' role='measure' type='quantitative' />
      <column caption='Eventid' datatype='integer' name='[EVENTID]' role='measure' type='quantitative' />
      <column caption='Interesttype' datatype='string' name='[INTERESTTYPE]' role='dimension' type='nominal' />
      <column caption='Lastpaymentdate' datatype='date' name='[LASTPAYMENTDATE]' role='dimension' type='ordinal' />
      <column caption='Loanid (Dummycollectionevents)' datatype='integer' name='[LOANID (DUMMYCOLLECTIONEVENTS)]' role='measure' type='quantitative' />
      <column caption='Loanid (Dummyloan)' datatype='integer' name='[LOANID (DUMMYLOAN)]' role='measure' type='quantitative' />
