      <column caption='Customername (Dummycustomermaster)' datatype='string' name='[CUSTOMERNAME (DUMMYCUSTOMERMASTER)]' role='dimension' type='nominal' />
      <column caption='Customername' datatype='string' name='[CUSTOMERNAME]' role='dimension' type='nominal' />
      <column caption='Customersk (Dimcustomer Backup)' datatype='integer' name='[CUSTOMERSK (DIMCUSTOMER_BACKUP)]' role='measure' type='quantitative' />
      <column caption='Customersk' datatype='integer' name='[CUSTOMERSK]' role='measure' type='quantitative' />
      <column caption='Month' datatype='datetime' name='[Calculation_1324902720438091776]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [EVENTDATE])' />
      </column>
      <column caption='Cure%' datatype='real' name='[Calculation_1324902720438906881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_315533453755633678]) / SUM([LOANID])) * 100' />
      </column>
      <column caption='MONTH' datatype='datetime' name='[Calculation_1324902720439861250]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [EVENTDATE])' />
      </column>
      <column caption='Contact Attempts' datatype='integer' name='[Calculation_1324902720471035908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IIF([ACTIONTYPE] IN (&quot;Call&quot;, &quot;FieldVisit&quot;, &quot;SMS&quot;, &quot;Email&quot;, &quot;LegalNotice&quot;), 1, 0)&#13;&#10;)' />
      </column>
      <column caption='PTP%' datatype='real' name='[Calculation_1324902720471171077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([PTP_FLAG])&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IIF([ACTIONTYPE] IN (&quot;Call&quot;, &quot;FieldVisit&quot;, &quot;SMS&quot;, &quot;Email&quot;, &quot;LegalNotice&quot;), 1, 0)&#13;&#10;)' />
      </column>
      <column caption='PTP Category' datatype='string' name='[Calculation_1324902720471539718]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1324902720471171077] &gt;= 0.43 THEN &#13;&#10;    &quot;High (≥ 43%)&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1324902720471171077] &gt;= 0.38 THEN &#13;&#10;    &quot;Medium (38% - 42%)&quot;&#13;&#10;&#13;&#10;ELSE &#13;&#10;    &quot;Low (&lt; 38%)&quot;&#13;&#10;END' />
      </column>
      <column caption='Origination Amount' datatype='real' name='[Calculation_1324902720488214537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ORIGINATIONAMOUNT] )' />
      </column>
      <column caption='Writeoff Amount' datatype='real' name='[Calculation_1324902720488607754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IIF([WRITEOFFFLAG] = 1, [CURRENTBALANCE], 0) )' />
      </column>
      <column caption='Recovery Amount' datatype='real' name='[Calculation_1324902720490557451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([PAYMENTAMOUNT])' />
      </column>
      <column caption='Net Loss' datatype='real' name='[Calculation_1324902720490688524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ORIGINATIONAMOUNT])&#13;&#10;- SUM([PAYMENTAMOUNT])&#13;&#10;- SUM( IIF([WRITEOFFFLAG] = 0, [CURRENTBALANCE], 0) )' />
      </column>
      <column caption='Loss Ratio' datatype='real' name='[Calculation_1324902720490807309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1324902720490688524] / [Calculation_1324902720488214537]' />
      </column>
      <column caption='Recovery Rate' datatype='real' name='[Calculation_1324902720490921998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1324902720490557451] / [Calculation_1324902720488607754]' />
      </column>
      <column caption='Waterfall Step' datatype='string' name='[Calculation_1324902720491409423]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [STATUS] = &quot;WrittenOff&quot; THEN &quot;Writeoff&quot;&#13;&#10;&#13;&#10;ELSEIF [PAYMENTAMOUNT] &gt; 0 THEN &quot;Recovery&quot;&#13;&#10;&#13;&#10;ELSEIF [STATUS] = &quot;Active&quot; &#13;&#10;   OR [STATUS] = &quot;Delinquent&quot; THEN &quot;Origination&quot;&#13;&#10;&#13;&#10;ELSEIF [STATUS] = &quot;Closed&quot;&#13;&#10;   AND [WRITEOFFFLAG] = 0&#13;&#10;   AND [CURRENTBALANCE] &gt; 0 THEN &quot;Net Loss&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Waterfall Running Sum' datatype='real' name='[Calculation_1324902720497303568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Calculation_1324902720500621330])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Waterfall Value' datatype='real' name='[Calculation_1324902720500621330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_1324902720491409423] = &quot;Origination&quot; THEN &#13;&#10;        [ORIGINATIONAMOUNT]&#13;&#10;&#13;&#10;    ELSEIF [Calculation_1324902720491409423] = &quot;Writeoff&quot; THEN &#13;&#10;        -IIF([WRITEOFFFLAG] = 1, [CURRENTBALANCE], 0)&#13;&#10;&#13;&#10;    ELSEIF [Calculation_1324902720491409423] = &quot;Recovery&quot; THEN &#13;&#10;        [PAYMENTAMOUNT]&#13;&#10;&#13;&#10;    ELSEIF [Calculation_1324902720491409423] = &quot;Net Loss&quot; THEN &#13;&#10;        [ORIGINATIONAMOUNT]&#13;&#10;        - IIF([WRITEOFFFLAG] = 1, [CURRENTBALANCE], 0)&#13;&#10;        - [PAYMENTAMOUNT]&#13;&#10;&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Waterfall Step Dimension' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_1324902720503656467]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1324902720491409423] = &quot;Origination&quot; THEN &quot;Origination&quot;&#13;&#10;ELSEIF [Calculation_1324902720491409423] = &quot;Writeoff&quot; THEN &quot;Writeoff&quot;&#13;&#10;ELSEIF [Calculation_1324902720491409423] = &quot;Recovery&quot; THEN &quot;Recovery&quot;&#13;&#10;ELSEIF [Calculation_1324902720491409423] = &quot;Net Loss&quot; THEN &quot;Net Loss&quot;&#13;&#10;END' />
      </column>
      <column caption='Waterfall Color' datatype='string' name='[Calculation_1324902720507330580]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1324902720500621330] &gt;= 0 THEN &quot;Increase&quot;&#13;&#10;ELSE &quot;Decrease&quot;&#13;&#10;END' />
      </column>
      <column caption='Origination Year' datatype='date' datatype-customized='true' name='[Calculation_1324902720520458261]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;yyyy&quot;, STR(YEAR([ORIGINATIONDATE])) )) ' />
      </column>
      <column caption='Total Origination' datatype='real' name='[Calculation_1324902720582103064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ORIGINATIONAMOUNT])' />
      </column>
      <column caption='Total Writeoff' datatype='real' name='[Calculation_1324902720582225945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([WRITEOFFFLAG]=1, [CURRENTBALANCE], 0))' />
      </column>
      <column caption='Total Recovery' datatype='real' name='[Calculation_1324902720582324250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([PAYMENTAMOUNT])' />
      </column>
      <column caption='Net Losses' datatype='real' name='[Calculation_1324902720582475803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1324902720582103064] - [Calculation_1324902720582225945] - [Calculation_1324902720582324250]' />
      </column>
      <column caption='Net Loss Ratio' datatype='real' name='[Calculation_1324902720582799388]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1324902720582475803] / [Calculation_1324902720582103064]' />
      </column>
      <column caption='Residual Loss' datatype='real' name='[Calculation_1324902720584327197]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IIF([STATUS] = &quot;Closed&quot;&#13;&#10;        AND [WRITEOFFFLAG] = 0&#13;&#10;        AND [CURRENTBALANCE] &gt; 0,&#13;&#10;        [CURRENTBALANCE],&#13;&#10;        0&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column caption='Loss Category' datatype='string' name='[Calculation_1324902720584548382]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [WRITEOFFFLAG] = 1 THEN &quot;Writeoff&quot;&#13;&#10;ELSEIF [PAYMENTAMOUNT] &gt; 0 THEN &quot;Recovery&quot;&#13;&#10;ELSEIF [STATUS] = &quot;Closed&quot; &#13;&#10;       AND [WRITEOFFFLAG] = 0 &#13;&#10;       AND [CURRENTBALANCE] &gt; 0 THEN &quot;Residual Loss&quot;&#13;&#10;END' />
      </column>
      <column caption='Value of Loss' datatype='real' name='[Calculation_1324902720584753183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IIF([Calculation_1324902720584548382] = &quot;Writeoff&quot;,&#13;&#10;        IIF([WRITEOFFFLAG] = 1, [CURRENTBALANCE], 0),&#13;&#10;&#13;&#10;    IIF([Calculation_1324902720584548382] = &quot;Recovery&quot;,&#13;&#10;        [PAYMENTAMOUNT],&#13;&#10;&#13;&#10;    IIF([Calculation_1324902720584548382] = &quot;Residual Loss&quot;,&#13;&#10;        IIF([STATUS] = &quot;Closed&quot;&#13;&#10;            AND [WRITEOFFFLAG] = 0&#13;&#10;            AND [CURRENTBALANCE] &gt; 0,&#13;&#10;            [CURRENTBALANCE], 0),&#13;&#10;&#13;&#10;    0)))&#13;&#10;)' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_1324902720790143013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Total Amount' datatype='real' name='[Calculation_1324902720790892582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE LOWER([STATUS])&#13;&#10;    WHEN &quot;active&quot; THEN [CURRENTBALANCE]&#13;&#10;    WHEN &quot;delinquent&quot; THEN -[CURRENTBALANCE]&#13;&#10;    WHEN &quot;write-off&quot; THEN -[CURRENTBALANCE]&#13;&#10;    WHEN &quot;closed&quot; THEN [CURRENTBALANCE]&#13;&#10;END' />
      </column>
      <column caption='change status' datatype='string' name='[Calculation_1324902720791023655]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1324902720790892582] &gt; 0 THEN &quot;Increase&quot;&#13;&#10;ELSE &quot;Decrease&quot;&#13;&#10;END' />
      </column>
      <column caption='PTP Count' datatype='integer' name='[Calculation_315533453672882177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([PTP_FLAG])' />
      </column>
      <column caption='calls made' datatype='integer' name='[Calculation_315533453687361538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ACTIONTYPE] = &quot;Call&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Total Actions' datatype='integer' name='[Calculation_315533453690277892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([EVENTID])' />
      </column>
      <column caption='PTP Percentage' datatype='real' name='[Calculation_315533453737635847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_315533453672882177] / COUNT([ACTIONTYPE])' />
      </column>
      <column caption='Total Payments' datatype='real' name='[Calculation_315533453738885128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([PAYMENTAMOUNT])' />
      </column>
      <column caption='Cases Handled loan' datatype='integer' name='[Calculation_315533453739139081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([LOANID])' />
      </column>
      <column caption='Cases Handled customer' datatype='integer' name='[Calculation_315533453739274250]' role='measure' type='quantitative'>
