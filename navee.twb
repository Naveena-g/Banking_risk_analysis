    <worksheet name='waterfall chart'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Benton Sans Book'>Waterfall Net Loss</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MY_SCHEMA' name='federated.1jaj6y417jjbjm1d2k5wt0fgwtdq' />
          </datasources>
          <datasource-dependencies datasource='federated.1jaj6y417jjbjm1d2k5wt0fgwtdq'>
            <column caption='Currentbalance' datatype='real' name='[CURRENTBALANCE]' role='measure' type='quantitative' />
            <column caption='Waterfall Step' datatype='string' name='[Calculation_1324902720491409423]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [STATUS] = &quot;WrittenOff&quot; THEN &quot;Writeoff&quot;&#13;&#10;&#13;&#10;ELSEIF [PAYMENTAMOUNT] &gt; 0 THEN &quot;Recovery&quot;&#13;&#10;&#13;&#10;ELSEIF [STATUS] = &quot;Active&quot; &#13;&#10;   OR [STATUS] = &quot;Delinquent&quot; THEN &quot;Origination&quot;&#13;&#10;&#13;&#10;ELSEIF [STATUS] = &quot;Closed&quot;&#13;&#10;   AND [WRITEOFFFLAG] = 0&#13;&#10;   AND [CURRENTBALANCE] &gt; 0 THEN &quot;Net Loss&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Waterfall Running Sum' datatype='real' name='[Calculation_1324902720497303568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([Calculation_1324902720500621330])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Waterfall Value' datatype='real' name='[Calculation_1324902720500621330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_1324902720491409423] = &quot;Origination&quot; THEN &#13;&#10;        [ORIGINATIONAMOUNT]&#13;&#10;&#13;&#10;    ELSEIF [Calculation_1324902720491409423] = &quot;Writeoff&quot; THEN &#13;&#10;        -IIF([WRITEOFFFLAG] = 1, [CURRENTBALANCE], 0)&#13;&#10;&#13;&#10;    ELSEIF [Calculation_1324902720491409423] = &quot;Recovery&quot; THEN &#13;&#10;        [PAYMENTAMOUNT]&#13;&#10;&#13;&#10;    ELSEIF [Calculation_1324902720491409423] = &quot;Net Loss&quot; THEN &#13;&#10;        [ORIGINATIONAMOUNT]&#13;&#10;        - IIF([WRITEOFFFLAG] = 1, [CURRENTBALANCE], 0)&#13;&#10;        - [PAYMENTAMOUNT]&#13;&#10;&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Waterfall Step Dimension' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_1324902720503656467]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1324902720491409423] = &quot;Origination&quot; THEN &quot;Origination&quot;&#13;&#10;ELSEIF [Calculation_1324902720491409423] = &quot;Writeoff&quot; THEN &quot;Writeoff&quot;&#13;&#10;ELSEIF [Calculation_1324902720491409423] = &quot;Recovery&quot; THEN &quot;Recovery&quot;&#13;&#10;ELSEIF [Calculation_1324902720491409423] = &quot;Net Loss&quot; THEN &quot;Net Loss&quot;&#13;&#10;END' />
            </column>
            <column caption='Waterfall Color' datatype='string' name='[Calculation_1324902720507330580]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1324902720500621330] &gt;= 0 THEN &quot;Increase&quot;&#13;&#10;ELSE &quot;Decrease&quot;&#13;&#10;END' />
            </column>
            <column caption='Origination Year' datatype='date' datatype-customized='true' name='[Calculation_1324902720520458261]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;yyyy&quot;, STR(YEAR([ORIGINATIONDATE])) )) ' />
            </column>
            <column caption='Originationamount' datatype='real' name='[ORIGINATIONAMOUNT]' role='measure' type='quantitative' />
            <column caption='Originationdate' datatype='date' name='[ORIGINATIONDATE]' role='dimension' type='ordinal' />
            <column caption='Paymentamount' datatype='real' name='[PAYMENTAMOUNT]' role='measure' type='quantitative' />
            <column caption='Status' datatype='string' name='[STATUS]' role='dimension' type='nominal' />
            <column caption='Writeoffflag' datatype='integer' name='[WRITEOFFFLAG]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1324902720503656467]' derivation='None' name='[none:Calculation_1324902720503656467:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1324902720497303568]' derivation='User' name='[usr:Calculation_1324902720497303568:qk:4]' pivot='key' type='quantitative'>
              <table-calc ordering-type='CellInPane' />
