          <datasource-dependencies datasource='federated.1jaj6y417jjbjm1d2k5wt0fgwtdq'>
            <column caption='Actiontype' datatype='string' name='[ACTIONTYPE]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Agentid' datatype='integer' name='[AGENTID]' role='dimension' type='ordinal' />
            <column caption='Customerid' datatype='integer' name='[CUSTOMERID]' role='measure' type='quantitative' />
            <column caption='PTP%' datatype='real' name='[Calculation_1324902720471171077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PTP_FLAG])&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IIF([ACTIONTYPE] IN (&quot;Call&quot;, &quot;FieldVisit&quot;, &quot;SMS&quot;, &quot;Email&quot;, &quot;LegalNotice&quot;), 1, 0)&#13;&#10;)' />
            </column>
            <column caption='PTP Category' datatype='string' name='[Calculation_1324902720471539718]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1324902720471171077] &gt;= 0.43 THEN &#13;&#10;    &quot;High (≥ 43%)&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1324902720471171077] &gt;= 0.38 THEN &#13;&#10;    &quot;Medium (38% - 42%)&quot;&#13;&#10;&#13;&#10;ELSE &#13;&#10;    &quot;Low (&lt; 38%)&quot;&#13;&#10;END' />
            </column>
            <column caption='PTP Count' datatype='integer' name='[Calculation_315533453672882177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PTP_FLAG])' />
            </column>
            <column caption='Total Actions' datatype='integer' name='[Calculation_315533453690277892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([EVENTID])' />
            </column>
            <column caption='PTP Percentage' datatype='real' name='[Calculation_315533453737635847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_315533453672882177] / COUNT([ACTIONTYPE])' />
            </column>
            <column caption='Total Payments' datatype='real' name='[Calculation_315533453738885128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PAYMENTAMOUNT])' />
            </column>
            <column caption='Cases Handled loan' datatype='integer' name='[Calculation_315533453739139081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([LOANID])' />
            </column>
            <column caption='Cases Handled customer' datatype='integer' name='[Calculation_315533453739274250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([CUSTOMERID])' />
            </column>
            <column caption='Eventid' datatype='integer' name='[EVENTID]' role='measure' type='quantitative' />
            <column caption='Loanid' datatype='integer' name='[LOANID]' role='measure' type='quantitative' />
            <column caption='Paymentamount' datatype='real' name='[PAYMENTAMOUNT]' role='measure' type='quantitative' />
